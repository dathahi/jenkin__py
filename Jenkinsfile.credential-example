pipeline {
    agent any
    environment {
        // Define env vars here
        API_KEY = credentials('api-key-id')
        DB_PASSWORD = credentials('db-password-id')
    }
    stages {
        stage('Build & Test') {
            steps {
                sh 'go test -v ./...'
                sh 'go build -o go-demo .'
            }
        }
        stage('Run') {
            steps {
                sh './go-demo &'
                sh 'sleep 2'
                sh 'curl -s localhost:8081 | grep "API_KEY"'
            }
        }
    }
}